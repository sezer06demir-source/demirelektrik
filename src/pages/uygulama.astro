---
/**
 * Demir Elektrik müşteri uygulaması (PWA). Google Play'de TWA olarak paketlenir.
 * Arıza bildirimi ve randevu talebi WhatsApp mesajına dönüştürülür; sunucu yok.
 */
import AppLayout from '@layouts/AppLayout.astro';
import Icon from '@components/Icon.astro';
import { site } from '@data/site';
import { allDistricts, landingDistricts } from '@data/districts';
import { neighborhoods } from '@data/neighborhoods';

// İlçe → mahalle listesi (ilçe sayfası mahalleleri + mahalle sayfaları, tekrarsız, Türkçe sıralı)
const hoodMap: Record<string, string[]> = {};
for (const d of landingDistricts) {
  const target = d.type === 'semt' && d.parent ? d.parent : d.name;
  const set = new Set(hoodMap[target] ?? []);
  if (d.type === 'semt') set.add(d.name);
  for (const n of d.content.neighborhoods) set.add(n.replace(/\s+Merkez$/i, '').trim());
  for (const nb of neighborhoods.filter((x) => x.districtSlug === d.slug)) set.add(nb.name);
  hoodMap[target] = [...set];
}
for (const k of Object.keys(hoodMap)) hoodMap[k].sort((a, b) => a.localeCompare(b, 'tr'));
const districtNames = allDistricts.map((d) => d.name);

const problems = [
  { key: 'sigorta', label: 'Sigorta atıyor', icon: 'power' },
  { key: 'elektrik-yok', label: 'Elektrik yok', icon: 'zap' },
  { key: 'priz-anahtar', label: 'Priz / anahtar arızası', icon: 'settings' },
  { key: 'kacak', label: 'Kaçak akım / çarpma', icon: 'alert-triangle' },
  { key: 'aydinlatma', label: 'Avize / spot / LED montajı', icon: 'lamp' },
  { key: 'pano', label: 'Pano işi', icon: 'circuit-board' },
  { key: 'tesisat', label: 'Tesisat yenileme', icon: 'cable' },
  { key: 'diger', label: 'Başka bir şey', icon: 'wrench' },
];

const slots = ['08:00 – 10:00', '10:00 – 12:00', '12:00 – 14:00', '14:00 – 16:00', '16:00 – 18:00', '18:00 – 20:00', '20:00 – 23:00'];

const title = 'Demir Elektrik Uygulaması | Arıza Bildir, Randevu Al';
const description = 'Ankara genelinde elektrik arızası bildirin, randevu isteyin ya da tek dokunuşla arayın. Demir Elektrik müşteri uygulaması.';
---

<AppLayout title={title} description={description}>
  <div class="app" data-open-start={site.hours.opens.split(':')[0]} data-open-end={site.hours.closes.split(':')[0]}>
    <header class="app__top">
      <div class="app__brand">
        <span class="app__mark" aria-hidden="true"><Icon name="zap" size={22} /></span>
        <div>
          <p class="app__name">Demir Elektrik</p>
          <p class="app__status" data-status>Sincan merkezli · Ankara geneli</p>
        </div>
      </div>
      <h1 class="app__title">Elektrik arızası mı var?</h1>
      <p class="app__lead">Arayın, WhatsApp'tan yazın ya da aşağıdaki formu doldurun. Ankara'nın her ilçesine geliyoruz.</p>
      <div class="app__actions">
        <a href={site.phone.href} class="app__btn app__btn--call">
          <Icon name="phone" size={22} />
          <span>Hemen ara<small>{site.phone.display}</small></span>
        </a>
        <a href={site.whatsapp.href} class="app__btn app__btn--wa" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={22} />
          <span>WhatsApp'tan yaz<small>Fotoğraf da gönderebilirsiniz</small></span>
        </a>
      </div>
    </header>

    <form class="req" id="req" novalidate data-wa={site.whatsapp.number}>
      <ol class="req__steps" aria-label="Adımlar">
        <li class="req__step is-active" data-step-tab="1"><span>1</span> Sorun</li>
        <li class="req__step" data-step-tab="2"><span>2</span> Yer ve zaman</li>
        <li class="req__step" data-step-tab="3"><span>3</span> İletişim</li>
      </ol>

      <fieldset class="req__panel is-active" data-step="1">
        <legend class="req__legend">Sorun nedir?</legend>
        <div class="req__chips" role="group" aria-label="Sorun türü">
          {
            problems.map((p, i) => (
              <label class="chip">
                <input type="radio" name="problem" value={p.label} required={i === 0} />
                <span class="chip__body">
                  <Icon name={p.icon} size={18} />
                  {p.label}
                </span>
              </label>
            ))
          }
        </div>
        <label class="req__field">
          <span class="req__label">Kısaca anlatın <em>(isteğe bağlı)</em></span>
          <textarea name="note" rows="3" maxlength="600" placeholder="Örn. Salon sigortası sürekli atıyor, mutfaktaki prizlerde elektrik yok."></textarea>
        </label>
        <div class="req__urgency" role="group" aria-label="Aciliyet">
          <label class="seg"><input type="radio" name="urgency" value="Acil, bugün" checked /><span>Acil, bugün</span></label>
          <label class="seg"><input type="radio" name="urgency" value="Randevu ile" /><span>Randevu ile</span></label>
        </div>
        <button type="button" class="req__next" data-next="2">Devam et</button>
      </fieldset>

      <fieldset class="req__panel" data-step="2">
        <legend class="req__legend">Nerede ve ne zaman?</legend>
        <label class="req__field">
          <span class="req__label">İlçe</span>
          <select name="district" required>
            <option value="">Seçin</option>
            {districtNames.map((d) => <option value={d}>{d}</option>)}
            <option value="Ankara dışı">Ankara dışı</option>
          </select>
        </label>
        <label class="req__field" data-hood-select>
          <span class="req__label">Mahalle</span>
          <select name="hood">
            <option value="">Önce ilçe seçin</option>
          </select>
        </label>
        <label class="req__field" data-hood-text hidden>
          <span class="req__label">Mahalle</span>
          <input type="text" name="hoodText" maxlength="60" placeholder="Mahalle adı" />
        </label>
        <label class="req__field">
          <span class="req__label">Adres <em>(sokak, bina, daire)</em></span>
          <input type="text" name="address" maxlength="120" autocomplete="street-address" placeholder="Örn. Alparslan Cad. No:24 Kat:2" />
        </label>
        <div class="req__when" data-when>
          <label class="req__field">
            <span class="req__label">Tarih</span>
            <input type="date" name="date" />
          </label>
          <label class="req__field">
            <span class="req__label">Saat aralığı</span>
            <select name="slot">
              <option value="">Fark etmez</option>
              {slots.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>
        </div>
        <p class="req__hint" data-when-hint hidden>Acil çağrılarda en kısa sürede geliyoruz; tarih seçmenize gerek yok.</p>
        <div class="req__nav">
          <button type="button" class="req__back" data-prev="1">Geri</button>
          <button type="button" class="req__next" data-next="3">Devam et</button>
        </div>
      </fieldset>

      <fieldset class="req__panel" data-step="3">
        <legend class="req__legend">Size nasıl ulaşalım?</legend>
        <label class="req__field">
          <span class="req__label">Adınız</span>
          <input type="text" name="name" required minlength="3" maxlength="80" autocomplete="name" placeholder="Ad Soyad" />
        </label>
        <label class="req__field">
          <span class="req__label">Telefon</span>
          <input type="tel" name="phone" required inputmode="tel" autocomplete="tel" pattern="^[0-9+()\s-]{10,20}$" placeholder="05xx xxx xx xx" />
        </label>
        <label class="req__consent">
          <input type="checkbox" name="consent" required />
          <span>Bilgilerimin talebimi yanıtlamak için kullanılmasını kabul ediyorum. <a href="/kvkk-aydinlatma-metni">Aydınlatma metni</a></span>
        </label>
        <div class="req__nav">
          <button type="button" class="req__back" data-prev="2">Geri</button>
          <button type="submit" class="req__send"><Icon name="whatsapp" size={20} /> WhatsApp ile gönder</button>
        </div>
        <p class="req__alt">WhatsApp kullanmıyorsanız <a href={site.phone.href}>arayın</a>, aynı bilgileri telefonda alalım.</p>
      </fieldset>

      <p class="req__status" data-status-msg role="status" aria-live="polite"></p>
    </form>

    <section class="app__after" data-done hidden>
      <span class="app__done-icon"><Icon name="check-circle" size={40} /></span>
      <h2>Mesajınız hazırlandı</h2>
      <p>WhatsApp açıldı; <strong>Gönder</strong>'e basmanız yeterli. Açılmadıysa aşağıdaki düğmeyi kullanın.</p>
      <a class="app__btn app__btn--wa" data-done-link href="#" target="_blank" rel="noopener"><Icon name="whatsapp" size={22} /><span>WhatsApp'ı aç</span></a>
      <button type="button" class="app__link" data-done-reset>Yeni talep oluştur</button>
    </section>

    <nav class="app__more" aria-label="Diğer sayfalar">
      <a href="/hizmetler"><Icon name="layers" size={18} /> Hizmetlerimiz</a>
      <a href="/hizmet-bolgeleri"><Icon name="map-pin" size={18} /> Hizmet bölgeleri</a>
      <a href="/projeler"><Icon name="image" size={18} /> Projelerimiz</a>
      <a href="/sss"><Icon name="clipboard-list" size={18} /> Sık sorulanlar</a>
    </nav>

    <footer class="app__foot">
      <p>{site.address.full}</p>
      <p>Her gün {site.hours.display} · <a href="/gizlilik-politikasi">Gizlilik</a></p>
    </footer>
  </div>

  <script is:inline type="application/json" id="hood-data" set:html={JSON.stringify(hoodMap)} />
</AppLayout>

<style>
  .app {
    max-width: 560px;
    margin-inline: auto;
    padding-bottom: 2rem;
  }

  /* --- üst alan --- */
  .app__top {
    background: #0b1220;
    color: #e5e7eb;
    padding: calc(1rem + env(safe-area-inset-top)) 1.25rem 1.5rem;
    border-radius: 0 0 22px 22px;
  }
  .app__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .app__mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #ffc107;
    color: #0b1220;
    flex: none;
  }
  .app__name {
    margin: 0;
    font-weight: 800;
    font-size: 1rem;
    color: #fff;
  }
  .app__status {
    margin: 0;
    font-size: 0.8rem;
    color: #94a3b8;
  }
  .app__status.is-open::before,
  .app__status.is-closed::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 0.4rem;
    background: #22c55e;
    vertical-align: middle;
  }
  .app__status.is-closed::before {
    background: #f59e0b;
  }
  .app__title {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .app__lead {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #cbd5e1;
    max-width: 40ch;
  }
  .app__actions {
    display: grid;
    gap: 0.625rem;
  }
  .app__btn {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.9rem 1.1rem;
    border-radius: 14px;
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    min-height: 60px;
    transition: transform 120ms ease;
  }
  .app__btn:active {
    transform: scale(0.985);
  }
  .app__btn span {
    display: grid;
    line-height: 1.15;
  }
  .app__btn small {
    font-weight: 500;
    font-size: 0.8rem;
    opacity: 0.85;
  }
  .app__btn--call {
    background: #ffc107;
    color: #0b1220;
  }
  .app__btn--wa {
    background: #1faf5a;
    color: #fff;
  }

  /* --- form --- */
  .req {
    padding: 1.5rem 1.25rem 0;
  }
  .req__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .req__step {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid #e2e8f0;
  }
  .req__step span {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #475569;
    font-size: 0.75rem;
  }
  .req__step.is-active {
    color: #0b1220;
    border-color: #ffc107;
  }
  .req__step.is-active span {
    background: #0b1220;
    color: #ffc107;
  }
  .req__step.is-done span {
    background: #1faf5a;
    color: #fff;
  }
  .req__panel {
    border: 0;
    margin: 0;
    padding: 0;
    display: none;
  }
  .req__panel.is-active {
    display: block;
  }
  .req__legend {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
    padding: 0;
  }
  .req__chips {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip__body {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0.6rem 0.75rem;
    border-radius: 12px;
    border: 1.5px solid #e2e8f0;
    background: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
  }
  .chip__body svg {
    color: #f59e0b;
    flex: none;
  }
  .chip input:checked + .chip__body {
    border-color: #0b1220;
    background: #0b1220;
    color: #fff;
  }
  .chip input:checked + .chip__body svg {
    color: #ffc107;
  }
  .chip input:focus-visible + .chip__body {
    outline: 3px solid #ffc107;
    outline-offset: 2px;
  }
  .req__field {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.875rem;
  }
  .req__label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
  }
  .req__label em {
    font-style: normal;
    font-weight: 500;
    color: #94a3b8;
  }
  .req input[type='text'],
  .req input[type='tel'],
  .req input[type='date'],
  .req select,
  .req textarea {
    width: 100%;
    box-sizing: border-box;
    min-height: 50px;
    padding: 0.7rem 0.85rem;
    border-radius: 12px;
    border: 1.5px solid #e2e8f0;
    background: #fff;
    font: inherit;
    font-size: 1rem;
    color: #0f172a;
  }
  .req textarea {
    resize: vertical;
    min-height: 84px;
  }
  .req input:focus,
  .req select:focus,
  .req textarea:focus {
    outline: none;
    border-color: #0b1220;
    box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.45);
  }
  .req .is-invalid {
    border-color: #dc2626;
  }
  .req__urgency {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    margin-bottom: 1.25rem;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .seg span {
    display: grid;
    place-items: center;
    min-height: 46px;
    font-weight: 600;
    font-size: 0.9rem;
    color: #475569;
    cursor: pointer;
  }
  .seg input:checked + span {
    background: #0b1220;
    color: #fff;
  }
  .req__when {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .req__hint {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: #64748b;
  }
  .req__nav {
    display: flex;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }
  .req__next,
  .req__send,
  .req__back {
    min-height: 54px;
    border-radius: 14px;
    font: inherit;
    font-weight: 800;
    font-size: 1rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .req__next,
  .req__send {
    flex: 1;
    width: 100%;
    border: 0;
    background: #0b1220;
    color: #fff;
  }
  .req__send {
    background: #1faf5a;
  }
  .req__back {
    flex: 0 0 auto;
    padding-inline: 1.1rem;
    border: 1.5px solid #cbd5e1;
    background: #fff;
    color: #0f172a;
  }
  .req__next:focus-visible,
  .req__send:focus-visible,
  .req__back:focus-visible {
    outline: 3px solid #ffc107;
    outline-offset: 2px;
  }
  .req__consent {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.85rem;
    color: #475569;
    margin: 0.25rem 0 1rem;
  }
  .req__consent input {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    accent-color: #0b1220;
  }
  .req__consent a,
  .req__alt a {
    color: #0b1220;
    font-weight: 700;
  }
  .req__alt {
    margin: 1rem 0 0;
    font-size: 0.85rem;
    color: #64748b;
  }
  .req__status {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    color: #b91c1c;
    min-height: 1.2em;
  }

  /* --- tamamlandı --- */
  .app__after {
    padding: 2rem 1.25rem 0;
    text-align: center;
  }
  .app__done-icon {
    color: #1faf5a;
  }
  .app__after h2 {
    margin: 0.5rem 0 0.25rem;
    font-size: 1.4rem;
    font-weight: 800;
  }
  .app__after p {
    margin: 0 auto 1.25rem;
    max-width: 36ch;
    color: #475569;
  }
  .app__after .app__btn {
    justify-content: center;
  }
  .app__link {
    display: block;
    margin: 1rem auto 0;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 700;
    color: #0b1220;
    text-decoration: underline;
    cursor: pointer;
  }

  /* --- alt bağlantılar --- */
  .app__more {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 2rem 1.25rem 0;
  }
  .app__more a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.5rem 0.75rem;
    border-radius: 12px;
    background: #fff;
    border: 1.5px solid #e2e8f0;
    color: #0f172a;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .app__more svg {
    color: #f59e0b;
  }
  .app__foot {
    padding: 1.5rem 1.25rem 0;
    font-size: 0.8rem;
    color: #64748b;
    text-align: center;
  }
  .app__foot p {
    margin: 0 0 0.25rem;
  }
  .app__foot a {
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .app__btn {
      transition: none;
    }
  }
  @media (min-width: 600px) {
    .app {
      padding-top: 1.5rem;
    }
    .app__top {
      border-radius: 22px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.app');
  const form = document.getElementById('req') as HTMLFormElement | null;
  if (root && form) {
    /* Açık / kapalı durumu (yerel saate göre) */
    const statusEl = root.querySelector<HTMLElement>('[data-status]');
    const openH = Number(root.dataset.openStart ?? 8);
    const closeH = Number(root.dataset.openEnd ?? 23);
    const paint = () => {
      if (!statusEl) return;
      const h = new Date().getHours() + new Date().getMinutes() / 60;
      const open = h >= openH && h < closeH;
      statusEl.textContent = open
        ? `Şu an açık · ${String(openH).padStart(2, '0')}:00 – ${closeH}:00 · Ankara geneli`
        : `Şu an kapalı · Sabah ${String(openH).padStart(2, '0')}:00'da açılıyor · Mesaj bırakabilirsiniz`;
      statusEl.classList.toggle('is-open', open);
      statusEl.classList.toggle('is-closed', !open);
    };
    paint();
    setInterval(paint, 60_000);

    /* Adımlar */
    const panels = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
    const tabs = [...form.querySelectorAll<HTMLElement>('[data-step-tab]')];
    let current = 1;
    const show = (n: number) => {
      current = n;
      panels.forEach((p) => p.classList.toggle('is-active', Number(p.dataset.step) === n));
      tabs.forEach((t) => {
        const k = Number(t.dataset.stepTab);
        t.classList.toggle('is-active', k === n);
        t.classList.toggle('is-done', k < n);
      });
      form.scrollIntoView({ block: 'start', behavior: 'smooth' });
      panels.find((p) => Number(p.dataset.step) === n)?.querySelector<HTMLElement>('input, select, textarea')?.focus({ preventScroll: true });
    };
    const statusMsg = form.querySelector<HTMLElement>('[data-status-msg]');
    const say = (m: string) => {
      if (statusMsg) statusMsg.textContent = m;
    };
    const validStep = (n: number): boolean => {
      say('');
      form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
      if (n === 1 && !form.querySelector<HTMLInputElement>('input[name="problem"]:checked')) {
        say('Devam etmek için bir sorun türü seçin.');
        return false;
      }
      if (n === 2) {
        const d = form.querySelector<HTMLSelectElement>('select[name="district"]')!;
        if (!d.value) {
          d.classList.add('is-invalid');
          d.focus();
          say('Lütfen ilçe seçin.');
          return false;
        }
      }
      if (n === 3) {
        const name = form.querySelector<HTMLInputElement>('input[name="name"]')!;
        const phone = form.querySelector<HTMLInputElement>('input[name="phone"]')!;
        const consent = form.querySelector<HTMLInputElement>('input[name="consent"]')!;
        if (name.value.trim().length < 3) {
          name.classList.add('is-invalid');
          name.focus();
          say('Adınızı yazın.');
          return false;
        }
        if (!/^[0-9+()\s-]{10,20}$/.test(phone.value.trim())) {
          phone.classList.add('is-invalid');
          phone.focus();
          say('Geçerli bir telefon numarası girin.');
          return false;
        }
        if (!consent.checked) {
          say('Devam etmek için onay kutusunu işaretleyin.');
          return false;
        }
      }
      return true;
    };
    form.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) =>
      b.addEventListener('click', () => {
        const next = Number(b.dataset.next);
        if (validStep(next - 1)) show(next);
      }),
    );
    form.querySelectorAll<HTMLButtonElement>('[data-prev]').forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.prev))));
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        const k = Number(t.dataset.stepTab);
        if (k < current) show(k);
      }),
    );

    /* Aciliyet → tarih alanı */
    const whenBox = form.querySelector<HTMLElement>('[data-when]');
    const whenHint = form.querySelector<HTMLElement>('[data-when-hint]');
    const dateInput = form.querySelector<HTMLInputElement>('input[name="date"]');
    if (dateInput) dateInput.min = new Date().toISOString().slice(0, 10);
    const syncUrgency = () => {
      const urgent = form.querySelector<HTMLInputElement>('input[name="urgency"]:checked')?.value.startsWith('Acil') ?? true;
      if (whenBox) whenBox.hidden = urgent;
      if (whenHint) whenHint.hidden = !urgent;
    };
    form.querySelectorAll<HTMLInputElement>('input[name="urgency"]').forEach((r) => r.addEventListener('change', syncUrgency));
    syncUrgency();

    /* İlçe → mahalle */
    const hoodData: Record<string, string[]> = JSON.parse(document.getElementById('hood-data')?.textContent ?? '{}');
    const districtSel = form.querySelector<HTMLSelectElement>('select[name="district"]')!;
    const hoodSelWrap = form.querySelector<HTMLElement>('[data-hood-select]')!;
    const hoodSel = form.querySelector<HTMLSelectElement>('select[name="hood"]')!;
    const hoodTextWrap = form.querySelector<HTMLElement>('[data-hood-text]')!;
    const syncHoods = () => {
      const list = hoodData[districtSel.value];
      if (list && list.length) {
        hoodSel.innerHTML = '<option value="">Seçin</option>' + list.map((h) => `<option value="${h}">${h}</option>`).join('') + '<option value="__other">Listede yok</option>';
        hoodSelWrap.hidden = false;
        hoodTextWrap.hidden = true;
      } else {
        hoodSelWrap.hidden = true;
        hoodTextWrap.hidden = !districtSel.value;
      }
    };
    districtSel.addEventListener('change', syncHoods);
    hoodSel.addEventListener('change', () => {
      hoodTextWrap.hidden = hoodSel.value !== '__other';
      if (hoodSel.value === '__other') hoodTextWrap.querySelector<HTMLInputElement>('input')?.focus();
    });
    syncHoods();

    /* Gönder → WhatsApp */
    const done = root.querySelector<HTMLElement>('[data-done]');
    const doneLink = root.querySelector<HTMLAnchorElement>('[data-done-link]');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validStep(3)) return;
      const v = (n: string) => (form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${n}"]`)?.value ?? '').trim();
      const problem = form.querySelector<HTMLInputElement>('input[name="problem"]:checked')?.value ?? '';
      const urgency = form.querySelector<HTMLInputElement>('input[name="urgency"]:checked')?.value ?? '';
      const hood = hoodSel.value && hoodSel.value !== '__other' ? hoodSel.value : v('hoodText');
      const date = v('date');
      const dateText = date ? new Date(date + 'T00:00:00').toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', weekday: 'long' }) : '';
      const lines = [
        'Merhaba Demir Elektrik, uygulama üzerinden talep gönderiyorum.',
        '',
        `Sorun: ${problem}`,
        `Aciliyet: ${urgency}`,
        v('note') ? `Açıklama: ${v('note')}` : '',
        '',
        `İlçe: ${v('district')}`,
        hood ? `Mahalle: ${hood}` : '',
        v('address') ? `Adres: ${v('address')}` : '',
        dateText ? `Tarih: ${dateText}` : '',
        v('slot') ? `Saat: ${v('slot')}` : '',
        '',
        `Ad Soyad: ${v('name')}`,
        `Telefon: ${v('phone')}`,
      ].filter((l) => l !== '');
      const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
      if (doneLink) doneLink.href = url;
      window.open(url, '_blank', 'noopener');
      form.hidden = true;
      if (done) {
        done.hidden = false;
        done.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    });
    root.querySelector<HTMLButtonElement>('[data-done-reset]')?.addEventListener('click', () => {
      form.reset();
      syncUrgency();
      syncHoods();
      form.hidden = false;
      if (done) done.hidden = true;
      show(1);
    });
  }
</script>
