---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import { site } from '@data/site';
import { breadcrumbSchema } from '@utils/seo';

const crumbs = [
  { name: 'Ana Sayfa', href: '/' },
  { name: 'Çerez Politikası', href: '/cerez-politikasi' },
];
---

<BaseLayout title="Çerez Politikası" description="Demir Elektrik web sitesinde kullanılan çerezler ve Google Ads dönüşüm ölçümü ve üçüncü taraf bileşenler hakkında bilgilendirme." schema={[breadcrumbSchema(crumbs)]}>
  <PageHero title="Çerez Politikası" breadcrumbs={crumbs} showCta={false} />
  <section class="section">
    <div class="container prose">
      <h2>Çerez Nedir?</h2>
      <p>Çerezler, ziyaret ettiğiniz web siteleri tarafından tarayıcınıza kaydedilen küçük metin dosyalarıdır.</p>

      <h2>Sitemizde Kullanılan Çerezler</h2>
      <p>
        {site.name} web sitesi, kendi adına analitik veya profil çıkarma amaçlı çerez kullanmaz. Siteyi ilk ziyaretinizde
        ekranın altında bir çerez tercihi çubuğu görürsünüz. Google reklam çerezleri yalnızca <strong>Kabul Et</strong>
        düğmesine bastığınızda etkinleşir.
      </p>

      <h2>Üçüncü Taraf Çerezleri</h2>
      <ul>
        <li>
          <strong>Google Ads dönüşüm ölçümü:</strong> Google reklamlarımızdan gelen ziyaretçilerin telefon veya WhatsApp
          düğmesine tıklayıp tıklamadığını ölçmek için kullanılır. Onay verirseniz Google tarayıcınıza reklam çerezi yazar.
          Onay vermezseniz çerez yazılmaz; Google'a yalnızca kimliğinizi içermeyen, çerezsiz bir sinyal gider. Seçiminiz
          tarayıcınızda saklanır.
        </li>
        <li>
          <strong>Google Haritalar:</strong> İletişim sayfasındaki harita bileşeni yüklendiğinde Google, kendi çerezlerini
          yerleştirebilir. Bu çerezler Google'ın gizlilik politikasına tabidir.
        </li>
      </ul>

      <h2>Çerezleri Yönetme</h2>
      <p>
        Verdiğiniz kararı istediğiniz zaman değiştirebilirsiniz:
        <button type="button" class="cookie-settings" data-cookie-settings>Çerez tercihlerimi değiştir</button>
      </p>
      <p>
        Tarayıcınızın ayarlarından da çerezleri silebilir veya engelleyebilirsiniz. Çerezleri engellemeniz sitemizin temel
        işlevlerini etkilemez; yalnızca harita bileşeni görüntülenmeyebilir.
      </p>

      <h2>İletişim</h2>
      <p>Çerezlerle ilgili sorularınız için <a href={site.phone.href}>{site.phone.display}</a> numarasından bize ulaşabilirsiniz.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .cookie-settings {
    display: inline-block;
    margin-left: 0.25rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-sm);
    background: var(--gray-light);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
</style>
