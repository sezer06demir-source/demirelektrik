---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import About from '@components/About.astro';
import WhyUs from '@components/WhyUs.astro';
import Areas from '@components/Areas.astro';
import Process from '@components/Process.astro';
import Stats from '@components/Stats.astro';
import CTASection from '@components/CTASection.astro';
import { breadcrumbSchema } from '@utils/seo';

const crumbs = [
  { name: 'Ana Sayfa', href: '/' },
  { name: 'Kurumsal', href: '/hakkimizda' },
];
---

<BaseLayout
  title="Hakkımızda | 30+ Yıllık Ankara Elektrik Tecrübesi | Demir Elektrik"
  rawTitle
  description="Demir Elektrik: Ankara genelinde yetkili elektrikçi. Recep Usta ve Sezer Usta, ustalık ve usta öğreticilik belgeli, 30+ yıl tecrübe. Sincan Yenikent merkezli."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Kurumsal"
    text="Ankara genelinde yetkili elektrikçi. Recep Usta ve Sezer Usta; ustalık ve usta öğreticilik belgeli, konut, ticari ve endüstriyel elektrikte 30 yılı aşkın tecrübe."
    breadcrumbs={crumbs}
    eyebrow="Hakkımızda"
  />
  <About headingLevel="h2" showLink={false} />
  <Stats />
  <WhyUs />
  <Areas />
  <Process />
  <CTASection title="Elektrik işiniz için bize ulaşın" text="Ev, iş yeri ya da fabrikanız için elektrik hizmeti almak üzere Demir Elektrik ile iletişime geçin." buttonLabel="Hemen Ara" />
</BaseLayout>
